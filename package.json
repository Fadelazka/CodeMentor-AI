    "intro:validate": "node scripts/validate-intro-video.mjs",
    "intro:placeholder": "cd video && npm run build:all && node ../scripts/copy-intro-output.mjs",
    "hero:validate": "node scripts/validate-hero-video.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
