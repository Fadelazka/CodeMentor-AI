    "@codemirror/view": "^6.22.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.20.0",
    "@uiw/react-codemirror": "^4.23.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
