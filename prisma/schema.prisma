generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String?
  nim          String?
  email        String?   @unique
  emailVerified DateTime?
  image        String?
  favoriteLanguage String?
  passwordHash String?
  provider     String?
  role         Role      @default(USER)
  quizScore       Int       @default(0)
  aiPreference    String    @default("medium")
  quizCompletedAt DateTime?
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  accounts     Account[]
  sessions     Session[]
  chatHistory  ChatHistory[]
  appFeedbacks AppFeedback[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token              String?
  refresh_token_expires_in  Int?
  access_token              String?
  expires_at                Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model ChatHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language     String
  errorCode    String?
  errorMessage String?
  sourceCode   String
  aiResponse   String
  confidence   Float?
  feedback     Feedback?
  feedbackComment String?
  feedbackAt   DateTime?
  responseTimeMs Int?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([language])
  @@index([createdAt])
}

enum Role {
  USER
  ADMIN
}

enum Feedback {
  HELPFUL
  NOT_HELPFUL
}

model KnowledgeBase {
  id          String   @id @default(cuid())
  language    String
  errorCode   String
  title       String
  description String
  solution    String
  examples    String?
  tags        String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([language, errorCode])
  @@index([language])
  @@index([errorCode])
}

model AppFeedback {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
